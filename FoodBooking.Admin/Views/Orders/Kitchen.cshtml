@model List<Order>
@{ ViewData["Title"] = "Kitchen Display"; }
<div class="toolbar">
    <span class="text-muted small"><i class="bi bi-arrow-repeat"></i> Auto-refreshes every 15 seconds · new orders flash and play a sound</span>
    <button class="btn btn-sm btn-light ms-auto" onclick="adminBeep()"><i class="bi bi-volume-up"></i> Test sound</button>
    <button class="btn btn-sm btn-light" onclick="document.documentElement.requestFullscreen()"><i class="bi bi-arrows-fullscreen"></i> Full screen</button>
</div>
<div id="board"><partial name="_KitchenBoard" model="Model" /></div>
@section Scripts {
    <script>
        function refresh() { $('#board').load('/orders/kitchen?partial=1'); }
        setInterval(refresh, 15000);
        $(document).on('admin:new-order', refresh);
        $(document).on('click', '[data-kitchen-action]', function () {
            const $b = $(this).prop('disabled', true);
            adminPost($b.data('kitchen-action'), { status: $b.data('status'), notifyCustomer: true }).always(refresh);
        });
    </script>
}
