@model NotificationLog
@{ ViewData["Title"] = "Log #" + Model.Id; }
<div class="toolbar"><a href="/messages/logs" class="btn btn-light btn-sm"><i class="bi bi-arrow-left"></i> Logs</a></div>
<div class="card">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-2">Channel</dt><dd class="col-sm-10">@Model.Channel</dd>
            <dt class="col-sm-2">To</dt><dd class="col-sm-10">@Model.Recipient</dd>
            <dt class="col-sm-2">Subject</dt><dd class="col-sm-10">@Model.Subject</dd>
            <dt class="col-sm-2">When</dt><dd class="col-sm-10">@Model.CreatedAt.ToLocalTime().ToString("MMM d, yyyy h:mm:ss tt")</dd>
            <dt class="col-sm-2">Result</dt><dd class="col-sm-10">@(Model.Success ? "Sent" : "Not sent") <span class="text-danger">@Model.Error</span></dd>
        </dl>
    </div>
</div>
@if (!string.IsNullOrEmpty(Model.Body))
{
    <div class="card mt-3">
        <div class="card-header">Content</div>
        <div class="card-body">
            @if (Model.Channel == NotificationChannel.Email)
            {
                <iframe sandbox="" srcdoc="@Model.Body" style="width:100%;height:600px;border:0"></iframe>
            }
            else { <pre class="mb-0" style="white-space:pre-wrap">@Model.Body</pre> }
        </div>
    </div>
}
