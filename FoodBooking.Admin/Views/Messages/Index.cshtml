@model List<ContactMessage>
@{ ViewData["Title"] = "Contact Messages"; }
<div class="card">
    <div class="table-responsive">
        <table class="table table-hover">
            <thead><tr><th>From</th><th>Subject</th><th>Received</th><th class="text-end"></th></tr></thead>
            <tbody>
                @foreach (var m in Model)
                {
                    <tr class="@(m.IsRead ? "" : "fw-semibold")">
                        <td><a href="/messages/details/@m.Id">@m.Name</a><div class="small text-muted fw-normal">@m.Email</div></td>
                        <td>@(m.Subject ?? (m.Message.Length > 60 ? m.Message[..60] + "…" : m.Message)) @if (!m.IsRead) { <span class="badge bg-danger">new</span> }</td>
                        <td class="small fw-normal">@m.CreatedAt.ToLocalTime().ToString("MMM d, yyyy h:mm tt")</td>
                        <td class="text-end"><form method="post" action="/messages/delete/@m.Id" class="d-inline" data-confirm="Delete this message?">@Html.AntiForgeryToken()<button class="btn btn-sm btn-light text-danger"><i class="bi bi-trash"></i></button></form></td>
                    </tr>
                }
                @if (Model.Count == 0) { <tr><td colspan="4" class="text-center text-muted py-4">No messages yet.</td></tr> }
            </tbody>
        </table>
    </div>
</div>
