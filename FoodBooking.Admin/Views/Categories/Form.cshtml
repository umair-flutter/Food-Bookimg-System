@model Category
@{ ViewData["Title"] = Model.Id == 0 ? "New Category" : "Edit Category"; }
<div class="toolbar"><a href="~/categories" class="btn btn-light btn-sm"><i class="bi bi-arrow-left"></i> Categories</a></div>
<div class="card" style="max-width:860px">
    <div class="card-body">
        <form method="post" action="~/categories/save" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="ImageUrl" />
            <div asp-validation-summary="All" class="text-danger small mb-2"></div>
            <div class="row g-3">
                <div class="col-md-6"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" /></div>
                <div class="col-md-4"><label asp-for="Slug" class="form-label">URL slug</label><input asp-for="Slug" class="form-control" placeholder="auto" /></div>
                <div class="col-md-2"><label asp-for="Icon" class="form-label">Icon (emoji)</label><input asp-for="Icon" class="form-control" maxlength="10" /></div>
                <div class="col-md-6"><label asp-for="ParentId" class="form-label">Parent category</label><select asp-for="ParentId" class="form-select" asp-items="ViewBag.Parents"><option value="">— top level —</option></select></div>
                <div class="col-md-6"><label asp-for="SortOrder" class="form-label">Sort order</label><input asp-for="SortOrder" class="form-control" /></div>
                <div class="col-12"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control" rows="2"></textarea></div>
                <div class="col-md-8"><label class="form-label">Image</label><input type="file" name="image" class="form-control" accept="image/*" data-preview="#prev" /></div>
                <div class="col-md-4"><img id="prev" src="@Model.ImageUrl" class="thumb @(Model.ImageUrl == null ? "d-none" : "")" style="width:90px;height:90px" alt="" /></div>
                <div class="col-md-6"><label asp-for="MetaTitle" class="form-label">Meta title</label><input asp-for="MetaTitle" class="form-control" /></div>
                <div class="col-md-6"><label asp-for="MetaDescription" class="form-label">Meta description</label><input asp-for="MetaDescription" class="form-control" /></div>
                <div class="col-12">
                    <div class="form-check form-check-inline"><input asp-for="IsActive" class="form-check-input" /><label asp-for="IsActive" class="form-check-label">Active</label></div>
                    <div class="form-check form-check-inline"><input asp-for="ShowOnHome" class="form-check-input" /><label asp-for="ShowOnHome" class="form-check-label">Show on home page</label></div>
                </div>
            </div>
            <button class="btn btn-primary mt-3"><i class="bi bi-save"></i> Save</button>
        </form>
    </div>
</div>
