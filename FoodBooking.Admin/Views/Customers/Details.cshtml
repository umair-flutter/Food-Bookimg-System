@model Customer
@{
    ViewData["Title"] = Model.FullName;
    var c = (await SettingsSvc.GetAsync()).CurrencySymbol;
    var valid = Model.Orders.Where(o => o.Status != OrderStatus.Cancelled).ToList();
}
<div class="toolbar"><a href="~/customers" class="btn btn-light btn-sm"><i class="bi bi-arrow-left"></i> Customers</a></div>
<div class="row g-3">
    <div class="col-xl-4">
        <div class="card">
            <div class="card-body">
                <h5 class="mb-1">@Model.FullName</h5>
                @if (Model.IsActive) { <span class="badge bg-success">Active</span> } else { <span class="badge bg-danger">Blocked</span> }
                <hr />
                <div><i class="bi bi-envelope me-2"></i><a href="mailto:@Model.Email">@Model.Email</a></div>
                <div><i class="bi bi-telephone me-2"></i>@Model.Phone</div>
                <div><i class="bi bi-geo-alt me-2"></i>@Model.Address @Model.City @Model.PostalCode</div>
                <div class="small text-muted mt-2">Registered @Model.CreatedAt.ToLocalTime().ToString("MMM d, yyyy") · last login @(Model.LastLoginAt?.ToLocalTime().ToString("MMM d, yyyy h:mm tt") ?? "never")</div>
                <hr />
                <div class="row text-center">
                    <div class="col"><div class="fs-4 fw-bold">@valid.Count</div><small class="text-muted">orders</small></div>
                    <div class="col"><div class="fs-4 fw-bold">@valid.Sum(o => o.Total).Money(c)</div><small class="text-muted">spent</small></div>
                </div>
                <form method="post" action="~/customers/toggleactive/@Model.Id" class="mt-3" data-confirm="@(Model.IsActive ? "Block" : "Activate") this customer?">
                    @Html.AntiForgeryToken()
                    <button class="btn btn-sm w-100 @(Model.IsActive ? "btn-outline-danger" : "btn-outline-success")">@(Model.IsActive ? "Block customer (prevent login)" : "Activate customer")</button>
                </form>
            </div>
        </div>
    </div>
    <div class="col-xl-8">
        <div class="card">
            <div class="card-header">Order history</div>
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead><tr><th>Order</th><th>Date</th><th>Type</th><th>Status</th><th>Payment</th><th class="text-end">Total</th></tr></thead>
                    <tbody>
                        @foreach (var o in Model.Orders)
                        {
                            <tr onclick="location='/orders/details/@o.Id'" style="cursor:pointer">
                                <td class="fw-semibold">#@o.OrderNumber</td>
                                <td class="small">@o.CreatedAt.ToLocalTime().ToString("MMM d, yyyy h:mm tt")</td>
                                <td>@o.OrderType</td>
                                <td><span class="badge bg-@o.Status.StatusBadge()">@o.Status.StatusText()</span></td>
                                <td class="small">@o.PaymentMethod.PaymentText()</td>
                                <td class="text-end">@o.Total.Money(c)</td>
                            </tr>
                        }
                        @if (Model.Orders.Count == 0) { <tr><td colspan="6" class="text-center text-muted py-4">No orders yet.</td></tr> }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
