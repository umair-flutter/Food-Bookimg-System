@model LoginModel
@{
    Layout = null;
    var s = await SettingsSvc.GetAsync();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Login · @s.CompanyName</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>
<body>
    <div class="login-wrap p-3">
        <div class="card login-card p-4 p-md-5">
            <div class="text-center mb-4">
                <div class="fs-1">🍽️</div>
                <h4 class="fw-bold mb-0">@s.CompanyName</h4>
                <small class="text-muted">Admin Panel</small>
            </div>
            <form method="post" action="/auth/login">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="ReturnUrl" />
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>
                <div class="mb-3">
                    <label asp-for="Username" class="form-label"></label>
                    <div class="input-group"><span class="input-group-text"><i class="bi bi-person"></i></span><input asp-for="Username" class="form-control" autofocus /></div>
                </div>
                <div class="mb-4">
                    <label asp-for="Password" class="form-label"></label>
                    <div class="input-group"><span class="input-group-text"><i class="bi bi-lock"></i></span><input asp-for="Password" class="form-control" /></div>
                </div>
                <button class="btn btn-primary w-100 py-2">Sign in</button>
            </form>
        </div>
    </div>
</body>
</html>
