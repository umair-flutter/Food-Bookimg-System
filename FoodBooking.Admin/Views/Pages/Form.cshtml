@model CmsPage
@{ ViewData["Title"] = Model.Id == 0 ? "New Page" : "Edit Page"; }
@section Head { <link href="https://cdn.jsdelivr.net/npm/summernote@0.8.20/dist/summernote-lite.min.css" rel="stylesheet" /> }
<div class="toolbar"><a href="~/pages" class="btn btn-light btn-sm"><i class="bi bi-arrow-left"></i> Pages</a></div>
<form method="post" action="~/pages/save">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="All" class="text-danger small mb-2"></div>
    <div class="row g-3">
        <div class="col-xl-8">
            <div class="card"><div class="card-body">
                <div class="mb-3"><label asp-for="Title" class="form-label"></label><input asp-for="Title" class="form-control" /></div>
                <label asp-for="Content" class="form-label"></label>
                <textarea asp-for="Content" class="form-control rich"></textarea>
            </div></div>
        </div>
        <div class="col-xl-4">
            <div class="card"><div class="card-body">
                <div class="mb-2"><label asp-for="Slug" class="form-label">URL slug</label><input asp-for="Slug" class="form-control" placeholder="auto" /></div>
                <div class="mb-2"><label asp-for="SortOrder" class="form-label">Sort order</label><input asp-for="SortOrder" class="form-control" /></div>
                <div class="form-check"><input asp-for="IsActive" class="form-check-input" /><label asp-for="IsActive" class="form-check-label">Published</label></div>
                <div class="form-check"><input asp-for="ShowInHeader" class="form-check-input" /><label asp-for="ShowInHeader" class="form-check-label">Show in header menu</label></div>
                <div class="form-check mb-3"><input asp-for="ShowInFooter" class="form-check-input" /><label asp-for="ShowInFooter" class="form-check-label">Show in footer links</label></div>
                <div class="mb-2"><label asp-for="MetaTitle" class="form-label">Meta title</label><input asp-for="MetaTitle" class="form-control" /></div>
                <div class="mb-3"><label asp-for="MetaDescription" class="form-label">Meta description</label><textarea asp-for="MetaDescription" class="form-control" rows="3"></textarea></div>
                <button class="btn btn-primary w-100"><i class="bi bi-save"></i> Save page</button>
            </div></div>
        </div>
    </div>
</form>
@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/summernote@0.8.20/dist/summernote-lite.min.js"></script>
    <script>$('.rich').summernote({ height: 420 });</script>
}
