@{
    var s = await SettingsSvc.GetAsync();
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    string Active(string c, string? a = null) => controller == c && (a == null || action == a) ? "active" : "";
    var section = Context.Request.Query["section"].ToString();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · @s.CompanyName Admin</title>
    <link rel="icon" href="@(s.FaviconUrl ?? "/favicon.ico")" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    @await RenderSectionAsync("Head", required: false)
    <script>window.APP_BASE = '@Url.Content("~/")';</script>
</head>
<body>
    <aside class="sidebar" id="sidebar">
        <a class="brand" href="~/"><span class="logo">🍽️</span><span>@s.CompanyName</span></a>
        <nav class="menu">
            <a class="@Active("Dashboard")" href="~/"><i class="bi bi-speedometer2"></i>Dashboard</a>

            <div class="menu-title">Orders</div>
            <a class="@Active("Orders", "Index") @Active("Orders", "Details")" href="~/orders"><i class="bi bi-receipt"></i>All Orders <span class="badge bg-danger ms-auto d-none" data-new-orders></span></a>
            <a class="@Active("Orders", "Kitchen")" href="~/orders/kitchen"><i class="bi bi-fire"></i>Kitchen Display</a>

            <div class="menu-title">Catalog</div>
            <a class="@Active("Products")" href="~/products"><i class="bi bi-egg-fried"></i>Products</a>
            <a class="@Active("Categories")" href="~/categories"><i class="bi bi-grid"></i>Categories</a>
            <a class="@Active("Brands")" href="~/brands"><i class="bi bi-award"></i>Brands</a>
            <a class="@Active("Tags")" href="~/tags"><i class="bi bi-tags"></i>Product Tags</a>
            <a class="@Active("Attributes")" href="~/attributes"><i class="bi bi-sliders"></i>Attributes &amp; Options</a>
            <a class="@Active("Holidays")" href="~/holidays"><i class="bi bi-calendar-event"></i>Holidays &amp; Hours</a>

            <div class="menu-title">Content</div>
            <a class="@Active("Pages")" href="~/pages"><i class="bi bi-file-earmark-richtext"></i>CMS Pages</a>
            <a class="@Active("Banners")" href="~/banners"><i class="bi bi-images"></i>Banners &amp; Ads</a>
            <a class="@Active("Coupons")" href="~/coupons"><i class="bi bi-ticket-perforated"></i>Coupons</a>

            <div class="menu-title">Customers &amp; Reports</div>
            <a class="@Active("Customers")" href="~/customers"><i class="bi bi-people"></i>Customers</a>
            <a class="@Active("Reports", "Index")" href="~/reports"><i class="bi bi-graph-up"></i>Order Report</a>
            <a class="@Active("Reports", "Products")" href="~/reports/products"><i class="bi bi-bar-chart"></i>Product Sales</a>
            <a class="@Active("Messages", "Index") @Active("Messages", "Details")" href="~/messages"><i class="bi bi-chat-dots"></i>Contact Messages</a>
            <a class="@Active("Messages", "Subscribers")" href="~/messages/subscribers"><i class="bi bi-envelope-heart"></i>Newsletter</a>

            <div class="menu-title">Website Configuration</div>
            @foreach (var sec in SettingsController.Sections)
            {
                <a class="@(controller == "Settings" && (section == sec.key || (section == "" && sec.key == "company" && action == "Index")) ? "active" : "")" href="~/settings?section=@sec.key"><i class="bi @sec.icon"></i>@sec.title</a>
            }
            <a class="@Active("Messages", "Logs") @Active("Messages", "Log")" href="~/messages/logs"><i class="bi bi-journal-text"></i>Notification Logs</a>
        </nav>
    </aside>

    <div class="main">
        <header class="topbar">
            <button class="btn btn-light d-lg-none" onclick="document.getElementById('sidebar').classList.toggle('open')"><i class="bi bi-list"></i></button>
            <h1 class="page-title">@ViewData["Title"]</h1>
            <div class="ms-auto d-flex align-items-center gap-2">
                <a class="btn btn-light btn-sm" href="@s.FrontSiteUrl" target="_blank"><i class="bi bi-box-arrow-up-right"></i> <span class="d-none d-md-inline">View website</span></a>
                <a class="btn btn-light btn-sm position-relative" href="~/orders?status=Pending" title="New orders">
                    <i class="bi bi-bell"></i><span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger d-none" data-new-orders></span>
                </a>
                <button class="btn btn-light btn-sm" id="soundToggle" title="Order alert sound"><i class="bi bi-volume-up"></i></button>
                <div class="dropdown">
                    <button class="btn btn-light btn-sm dropdown-toggle" data-bs-toggle="dropdown"><i class="bi bi-person-circle"></i> @User.Identity?.Name</button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><a class="dropdown-item" href="~/auth/changepassword"><i class="bi bi-key me-2"></i>Change password</a></li>
                        <li><hr class="dropdown-divider" /></li>
                        <li><form method="post" action="~/auth/logout">@Html.AntiForgeryToken()<button class="dropdown-item text-danger"><i class="bi bi-box-arrow-right me-2"></i>Logout</button></form></li>
                    </ul>
                </div>
            </div>
        </header>
        <div class="content">
            @if (TempData["Success"] is string ok) { <div class="alert alert-success alert-dismissible fade show"><i class="bi bi-check-circle me-2"></i>@ok<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div> }
            @if (TempData["Error"] is string err) { <div class="alert alert-danger alert-dismissible fade show"><i class="bi bi-exclamation-triangle me-2"></i>@err<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div> }
            @RenderBody()
        </div>
    </div>

    <div class="toast-container position-fixed bottom-0 end-0 p-3" id="toasts"></div>
    @Html.AntiForgeryToken()
    <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>window.ADMIN = { currency: @Json.Serialize(s.CurrencySymbol) };</script>
    <script src="~/js/admin.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
