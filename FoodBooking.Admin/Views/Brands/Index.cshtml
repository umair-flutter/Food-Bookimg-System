@model List<Brand>
@{ ViewData["Title"] = "Brands"; }
<div class="toolbar"><a href="~/brands/create" class="btn btn-primary btn-sm ms-auto"><i class="bi bi-plus-lg"></i> New brand</a></div>
<div class="card">
    <div class="table-responsive">
        <table class="table table-hover">
            <thead><tr><th></th><th>Name</th><th>Products</th><th>Order</th><th>Status</th><th class="text-end">Actions</th></tr></thead>
            <tbody>
                @foreach (var b in Model)
                {
                    <tr>
                        <td><img class="thumb" src="@(b.LogoUrl ?? "")" alt="" /></td>
                        <td><a href="~/brands/edit/@b.Id" class="fw-semibold">@b.Name</a><div class="small text-muted">/brand/@b.Slug</div></td>
                        <td>@b.Products.Count</td>
                        <td>@b.SortOrder</td>
                        <td>@if (b.IsActive) { <span class="badge bg-success">Active</span> } else { <span class="badge bg-secondary">Hidden</span> }</td>
                        <td class="text-end text-nowrap">
                            <a href="~/brands/edit/@b.Id" class="btn btn-sm btn-light"><i class="bi bi-pencil"></i></a>
                            <form method="post" action="~/brands/delete/@b.Id" class="d-inline" data-confirm="Delete brand @b.Name?">@Html.AntiForgeryToken()<button class="btn btn-sm btn-light text-danger"><i class="bi bi-trash"></i></button></form>
                        </td>
                    </tr>
                }
                @if (Model.Count == 0) { <tr><td colspan="6" class="text-center text-muted py-4">No brands yet.</td></tr> }
            </tbody>
        </table>
    </div>
</div>
