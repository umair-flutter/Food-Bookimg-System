@model Order
@{
    var s = await Site.SettingsAsync();
    var c = s.CurrencySymbol;
    var placed = ViewBag.Placed == true;
}
<div class="container py-5" style="max-width:900px">
    @if (placed)
    {
        <div class="text-center mb-4 no-print">
            <div class="success-burst">🎉</div>
            <h2>Thank you, @Model.CustomerName.Split(' ')[0]!</h2>
            <p class="text-muted">Your order <strong>#@Model.OrderNumber</strong> has been received. A confirmation has been sent to <strong>@Model.Email</strong>.</p>
        </div>
    }
    <div class="no-print"><partial name="_StatusTimeline" model="Model" /></div>

    <div class="invoice">
        <div class="d-flex justify-content-between flex-wrap gap-3 mb-4">
            <div>
                @if (!string.IsNullOrEmpty(s.LogoUrl)) { <img src="@s.LogoUrl" style="max-height:50px" alt="" /> } else { <h3 class="mb-0">🍽️ @s.CompanyName</h3> }
                <div class="small text-muted mt-2">@s.Address<br />@s.Phone · @s.Email</div>
            </div>
            <div class="text-md-end">
                <h4 class="mb-1">INVOICE</h4>
                <div>Order <strong>#@Model.OrderNumber</strong></div>
                <div class="small text-muted">@Model.CreatedAt.ToLocalTime().ToString("MMM d, yyyy h:mm tt")</div>
                <span class="badge bg-@Model.Status.StatusBadge() mt-1">@Model.Status.StatusText()</span>
                <span class="badge bg-@Model.PaymentStatus.PaymentBadge() mt-1">@Model.PaymentStatus</span>
            </div>
        </div>
        <div class="row g-4 mb-4">
            <div class="col-md-6">
                <h6 class="text-muted text-uppercase small">Customer</h6>
                <div class="fw-semibold">@Model.CustomerName</div>
                <div>@Model.Phone</div>
                <div>@Model.Email</div>
                @if (Model.OrderType == OrderType.Delivery) { <div class="mt-1">@Model.Address<br />@Model.City @Model.PostalCode</div> }
            </div>
            <div class="col-md-6 text-md-end">
                <h6 class="text-muted text-uppercase small">Order info</h6>
                <div><strong>@Model.OrderType</strong> · @(Model.ScheduledFor?.ToString("ddd, MMM d h:mm tt") ?? "ASAP")</div>
                <div>@Model.PaymentMethod.PaymentText()</div>
                @if (!string.IsNullOrEmpty(Model.TransactionId)) { <div class="small text-muted">Txn: @Model.TransactionId</div> }
                @if (!string.IsNullOrEmpty(Model.Notes)) { <div class="small mt-1"><i class="bi bi-chat-left-text"></i> @Model.Notes</div> }
            </div>
        </div>
        <div class="table-responsive">
            <table class="table align-middle">
                <thead class="table-light"><tr><th>Item</th><th class="text-center">Qty</th><th class="text-end">Price</th><th class="text-end">Total</th></tr></thead>
                <tbody>
                    @foreach (var i in Model.Items)
                    {
                        <tr>
                            <td><div class="fw-semibold">@i.ProductName</div>@if (!string.IsNullOrEmpty(i.OptionsText)) { <small class="text-muted">@i.OptionsText</small> }</td>
                            <td class="text-center">@i.Quantity</td>
                            <td class="text-end">@i.UnitPrice.Money(c)</td>
                            <td class="text-end">@i.LineTotal.Money(c)</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr><td colspan="3" class="text-end">Subtotal</td><td class="text-end">@Model.SubTotal.Money(c)</td></tr>
                    @if (Model.Discount > 0) { <tr class="text-success"><td colspan="3" class="text-end">Discount (@Model.CouponCode)</td><td class="text-end">-@Model.Discount.Money(c)</td></tr> }
                    @if (Model.Tax > 0) { <tr><td colspan="3" class="text-end">Tax</td><td class="text-end">@Model.Tax.Money(c)</td></tr> }
                    @if (Model.DeliveryCharge > 0) { <tr><td colspan="3" class="text-end">Delivery</td><td class="text-end">@Model.DeliveryCharge.Money(c)</td></tr> }
                    @if (Model.Tip > 0) { <tr><td colspan="3" class="text-end">Tip</td><td class="text-end">@Model.Tip.Money(c)</td></tr> }
                    <tr class="fs-5"><th colspan="3" class="text-end">Total</th><th class="text-end text-primary">@Model.Total.Money(c)</th></tr>
                </tfoot>
            </table>
        </div>
        <p class="text-center text-muted small mt-4 mb-0">Thank you for ordering with @s.CompanyName!</p>
    </div>

    <div class="d-flex justify-content-center gap-2 mt-4 no-print flex-wrap">
        <button class="btn btn-dark" onclick="window.print()"><i class="bi bi-printer"></i> Print invoice</button>
        <a class="btn btn-outline-dark" href="/order/track?number=@Model.OrderNumber&key=@Model.AccessKey"><i class="bi bi-geo-alt"></i> Track order</a>
        <a class="btn btn-primary" href="/menu">Order more</a>
    </div>
</div>
