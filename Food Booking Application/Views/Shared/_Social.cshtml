@model SiteSetting
<span class="social">
    @if (!string.IsNullOrEmpty(Model.FacebookUrl)) { <a href="@Model.FacebookUrl" target="_blank" rel="noopener" aria-label="Facebook"><i class="bi bi-facebook"></i></a> }
    @if (!string.IsNullOrEmpty(Model.InstagramUrl)) { <a href="@Model.InstagramUrl" target="_blank" rel="noopener" aria-label="Instagram"><i class="bi bi-instagram"></i></a> }
    @if (!string.IsNullOrEmpty(Model.TwitterUrl)) { <a href="@Model.TwitterUrl" target="_blank" rel="noopener" aria-label="X / Twitter"><i class="bi bi-twitter-x"></i></a> }
    @if (!string.IsNullOrEmpty(Model.YoutubeUrl)) { <a href="@Model.YoutubeUrl" target="_blank" rel="noopener" aria-label="YouTube"><i class="bi bi-youtube"></i></a> }
    @if (!string.IsNullOrEmpty(Model.LinkedinUrl)) { <a href="@Model.LinkedinUrl" target="_blank" rel="noopener" aria-label="LinkedIn"><i class="bi bi-linkedin"></i></a> }
    @if (!string.IsNullOrEmpty(Model.TiktokUrl)) { <a href="@Model.TiktokUrl" target="_blank" rel="noopener" aria-label="TikTok"><i class="bi bi-tiktok"></i></a> }
</span>
