@model RegisterViewModel
<div class="container py-5">
    <div class="card p-4 p-md-5 auth-card">
        <div class="text-center mb-4"><div class="fs-1">🍔</div><h3>Create your account</h3><p class="text-muted">Save your details, track orders and re-order in one click.</p></div>
        <form method="post" action="/account/register">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="ReturnUrl" />
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>
            <div class="row g-3">
                <div class="col-6"><label asp-for="FirstName" class="form-label"></label><input asp-for="FirstName" class="form-control" /><span asp-validation-for="FirstName" class="text-danger small"></span></div>
                <div class="col-6"><label asp-for="LastName" class="form-label"></label><input asp-for="LastName" class="form-control" /></div>
                <div class="col-12"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" /><span asp-validation-for="Email" class="text-danger small"></span></div>
                <div class="col-12"><label asp-for="Phone" class="form-label"></label><input asp-for="Phone" class="form-control" /><span asp-validation-for="Phone" class="text-danger small"></span></div>
                <div class="col-6"><label asp-for="Password" class="form-label"></label><input asp-for="Password" class="form-control" /><span asp-validation-for="Password" class="text-danger small"></span></div>
                <div class="col-6"><label asp-for="ConfirmPassword" class="form-label"></label><input asp-for="ConfirmPassword" class="form-control" /><span asp-validation-for="ConfirmPassword" class="text-danger small"></span></div>
            </div>
            <button class="btn btn-primary w-100 btn-lg mt-4">Create account</button>
        </form>
        <p class="text-center mt-4 mb-0 small">Already have an account? <a href="/account/login">Log in</a></p>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
