@model ForgotPasswordViewModel
<div class="container py-5">
    <div class="card p-4 p-md-5 auth-card">
        <div class="text-center mb-4"><div class="fs-1">🔑</div><h3>Forgot your password?</h3><p class="text-muted">Enter your email and we'll send you a link to reset it.</p></div>
        <form method="post" action="/account/forgot-password">
            @Html.AntiForgeryToken()
            <div class="mb-3"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" /><span asp-validation-for="Email" class="text-danger small"></span></div>
            <button class="btn btn-primary w-100 btn-lg">Send reset link</button>
        </form>
        <p class="text-center mt-4 mb-0 small"><a href="/account/login"><i class="bi bi-arrow-left"></i> Back to login</a></p>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
