@model Customer
@{
    var s = await Site.SettingsAsync();
    var orders = (List<Order>)ViewBag.Orders;
}
<div class="page-hero"><div class="container"><h1>My account</h1></div></div>
<div class="container py-5">
    <div class="row g-4">
        <div class="col-lg-3"><partial name="_AccountNav" /></div>
        <div class="col-lg-9">
            <h4>Hello, @Model.FirstName 👋</h4>
            <p class="text-muted">Member since @Model.CreatedAt.ToString("MMMM yyyy")</p>
            <div class="row g-3 mb-4">
                <div class="col-md-4"><div class="stat-card"><small class="text-muted">Total orders</small><div class="num">@ViewBag.OrderCount</div></div></div>
                <div class="col-md-4"><div class="stat-card"><small class="text-muted">Total spent</small><div class="num">@(((decimal)ViewBag.TotalSpent).Money(s.CurrencySymbol))</div></div></div>
                <div class="col-md-4"><div class="stat-card"><small class="text-muted">Default address</small><div class="small mt-2">@(Model.Address == null ? "Not set" : $"{Model.Address}, {Model.City}")</div></div></div>
            </div>
            <div class="card p-4">
                <div class="d-flex justify-content-between"><h5>Recent orders</h5><a href="/account/orders">View all</a></div>
                @if (orders.Count == 0)
                {
                    <div class="empty-state py-4"><div class="icon">🍽️</div><p class="text-muted">You haven't placed any orders yet.</p><a href="/menu" class="btn btn-primary">Order now</a></div>
                }
                else
                {
                    <div class="table-responsive"><table class="table align-middle mb-0"><tbody>
                        @foreach (var o in orders) { <partial name="_OrderRow" model="o" /> }
                    </tbody></table></div>
                }
            </div>
        </div>
    </div>
</div>
