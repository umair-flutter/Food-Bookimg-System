@model LoginViewModel
<div class="container py-5">
    <div class="card p-4 p-md-5 auth-card">
        <div class="text-center mb-4"><div class="fs-1">👋</div><h3>Welcome back</h3><p class="text-muted">Log in to track orders and check out faster.</p></div>
        <form method="post" action="/account/login">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="ReturnUrl" />
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-2" role="alert"></div>
            <div class="mb-3"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" autofocus /><span asp-validation-for="Email" class="text-danger small"></span></div>
            <div class="mb-2"><label asp-for="Password" class="form-label"></label><input asp-for="Password" class="form-control" /><span asp-validation-for="Password" class="text-danger small"></span></div>
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div class="form-check"><input asp-for="RememberMe" class="form-check-input" /><label asp-for="RememberMe" class="form-check-label small"></label></div>
                <a href="/account/forgot-password" class="small">Forgot password?</a>
            </div>
            <button class="btn btn-primary w-100 btn-lg">Log in</button>
        </form>
        <p class="text-center mt-4 mb-0 small">New here? <a href="/account/register?returnUrl=@Uri.EscapeDataString(Model.ReturnUrl ?? "")">Create an account</a></p>
        @if (Model.ReturnUrl == "/checkout") { <p class="text-center mt-2 mb-0 small">or <a href="/checkout">continue as guest</a></p> }
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
